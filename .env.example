# Copy to .env (gitignored) at the repo root.

# Required for any Wikipedia API call (Wikimedia rejects anonymous clients).
WIKI_CONTACT=you@example.com

# Optional: leave unset to run the web app in demo mode with sample products.
SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
