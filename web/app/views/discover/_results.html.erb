<%# Discover's results: rendered inline (?inline=1) or fetched by app.js from /discover/results. %>
<div class="banners">
<% if @result %>
  <div class="banner info">
    <strong>How these were found:</strong>
    the <%= number_with_delimiter(@result.scanned) %> most-read English Wikipedia articles for
    <%= human_week_range(@result.week_start, @result.week_end) %>,
    kept only if Wikidata says they're a product (toys, food, drinks, clothing, beauty, gadgets, games, brands).
    Only big trends make that list: roughly 10,000+ views a day.
  </div>
  <%= render "trends/hindsight_banner", rows: @result.surging if @replay %>
<% end %>
<% if @error %><div class="banner critical">Couldn't scan Wikipedia right now: <%= @error %>. Try again in a minute.</div><% end %>
</div>

<% if @result %>
  <section>
    <div class="section-head">
      <h2 class="section-title">Surging. <span>Interest jumped in the last 10 weeks. Click a card for its chart.</span></h2>
    </div>
    <% if @result.surging.any? %>
      <div class="product-grid">
        <%= render partial: "trends/card", collection: @result.surging, as: :row, locals: { show_mapping: false } %>
      </div>
    <% else %>
      <p class="empty-state">No product on the most-read list had a 3× jump this week. That's normal: big product
        surges are rare. Try <%= link_to "the fidget spinner week", discover_path(as_of: "2017-06-12") %>.</p>
    <% end %>
  </section>

  <% if @result.steady.any? %>
    <section class="steady">
      <div class="section-head">
        <h2 class="section-title">Popular, no jump. <span>Heavily read, but steady, or still up from an older surge.</span></h2>
      </div>
      <ul class="steady-list">
        <% @result.steady.each do |row| %>
          <li>
            <%= link_to row.article, trend_path(article: row.article, as_of: (@replay ? params[:as_of] : nil)), data: { trend: true } %>
            <span class="muted"><%= row.kinds.first %> · <%= row.result.label.downcase %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
