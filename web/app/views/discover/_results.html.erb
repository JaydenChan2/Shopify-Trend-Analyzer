<%# Discover's results: rendered inline (?inline=1) or fetched by app.js from /discover/results. %>
<div class="banners">
<% if @result %>
  <div class="banner info">
    <strong>How these were found:</strong>
    every product among the most-read English Wikipedia articles from
    <%= human_week_range(@result.lookback_start, @result.week_end) %>
    (<%= number_with_delimiter(@result.scanned) %> articles checked; Wikidata says which are products),
    ranked by momentum: last week's views against the 8 weeks before. Only big trends make that list,
    roughly 10,000+ views a day. Momentum only sets the order; each label is the usual call.
  </div>
  <%= render "trends/hindsight_banner", rows: @result.top + @result.others if @replay %>
<% end %>
<% if @error %><div class="banner critical">Couldn't scan Wikipedia right now: <%= @error %>. Try again in a minute.</div><% end %>
</div>

<% if @result %>
  <section>
    <div class="section-head">
      <h2 class="section-title">Top <%= TrendingProducts::TOP_N %> by momentum <span>Ranked by last week's jump. Click a card for its chart.</span></h2>
    </div>
    <% if @result.top.any? %>
      <div class="product-grid">
        <%= render partial: "trends/card", collection: @result.top, as: :row, locals: { show_mapping: false, ranked: true } %>
      </div>
      <% if @result.top.none? { |row| row.result.onset_week } %>
        <p class="fineprint">None of these has cleared the surge rule (3× its usual level, two weeks running) yet,
          so they're rising, not surging. Big product surges are rare: see <%= link_to "the fidget spinner week", discover_path(as_of: "2017-06-12") %>.</p>
      <% end %>
    <% else %>
      <p class="empty-state">No products on the most-read list in these four weeks. Try <%= link_to "the fidget spinner week", discover_path(as_of: "2017-06-12") %>.</p>
    <% end %>
  </section>

  <% if @result.others.any? %>
    <section class="steady">
      <div class="section-head">
        <h2 class="section-title">Also on the list <span>Heavily read in the last four weeks, less momentum.</span></h2>
      </div>
      <ul class="steady-list">
        <% @result.others.each do |row| %>
          <li>
            <%= link_to row.article, trend_path(article: row.article, as_of: (@replay ? params[:as_of] : nil)), data: { trend: true } %>
            <span class="muted"><%= row.kinds.first %> · <%= format("%.1f", row.momentum || 0) %>× · <%= row.result.label.downcase %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
