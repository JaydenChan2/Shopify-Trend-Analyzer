<%# Discover: products surging on Wikipedia, found without a store. See app/services/trending_products.rb. %>
<% content_for :title, "Discover · Spike or Stay" %>
<% content_for :description, "Products people suddenly started reading about on Wikipedia this week, each checked for whether the surge looks like a spike or a stayer." %>
<%= render "shared/nav" %>

<main class="wrap app">
  <section class="app-head">
    <div>
      <p class="eyebrow">Discover</p>
      <h1><%= @replay ? "What was rising then" : "What's rising this week" %></h1>
      <p class="lede">Products people suddenly started reading about on Wikipedia, whether or not you stock them,
        put through the same checks as your own products.</p>
    </div>
    <div class="app-head-actions">
      <% if @replay %>
        <%= link_to "Back to this week", discover_path, class: "btn btn-outline btn-sm" %>
      <% else %>
        <%= link_to "See the fidget spinner week", discover_path(as_of: "2017-06-12"), class: "btn btn-outline btn-sm" %>
      <% end %>
      <%= link_to "Your products", dashboard_path(as_of: (@replay ? params[:as_of] : nil)), class: "btn btn-ghost-dark btn-sm" %>
    </div>
  </section>

  <% if @replay || @as_of_error %>
  <div class="banners">
    <% if @replay %>
      <div class="banner info">
        <strong>Replay as of <%= human_date(@as_of) %>.</strong>
        Only data from complete weeks up to <%= human_date(LiveLabel.last_complete_week_end(@as_of)) %> is used.
        <%= link_to "Back to this week ›", discover_path %>
      </div>
    <% end %>
    <% if @as_of_error %><div class="banner warning"><%= @as_of_error %></div><% end %>
  </div>
  <% end %>

  <%# Scanning Wikipedia can take a few seconds when the cache is cold, so the page
      renders first and app.js loads the results from /discover/results. %>
  <% if @result || @error %>
    <%= render "discover/results" %>
  <% else %>
    <%= render "shared/lazy", src: discover_results_path(as_of: (@replay ? params[:as_of] : nil)),
               fallback: discover_path(as_of: (@replay ? params[:as_of] : nil), inline: 1),
               what: "this week's most-read products" %>
  <% end %>
</main>

<%= render "shared/footer" %>

<dialog class="trend-dialog" aria-label="Product trend">
  <form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="Close">×</button></form>
  <div class="dialog-body" tabindex="-1"></div>
</dialog>
