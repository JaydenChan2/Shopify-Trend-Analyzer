<%# Site navigation, shared by every page. On narrow screens the links move into a
    menu (button + panel, wired up in app.js); the footer repeats them without JS. %>
<% replay_as_of = @replay ? params[:as_of] : nil %>
<% on_dashboard = current_page?(dashboard_path) %>
<% links = [["Discover", discover_path], ["How it works", methodology_path],
            ["Results", methodology_path(anchor: "results")], ["Replays", root_path(anchor: "replays")]] %>
<header class="site-nav">
  <div class="nav-inner">
    <%= link_to root_path, class: "brand" do %><%= render "shared/logo" %><span>Spike or Stay</span><% end %>
    <nav class="nav-links" aria-label="Main">
      <% links.each do |name, path| %>
        <%= link_to name, path, class: ("is-active" if current_page?(path)), "aria-current": ("page" if current_page?(path)) %>
      <% end %>
    </nav>
    <div class="nav-actions">
      <% if @replay %><span class="pill pill-accent nav-replay">Replay · <%= @as_of.strftime("%b %-d, %Y") %></span><% end %>
      <% if @source && (DemoMode.on? || @source.mode == :demo) %>
        <span class="pill nav-status">Demo store</span>
      <% elsif @source&.shop %>
        <span class="pill nav-status" title="<%= @source.shop %>"><span class="live-dot" aria-hidden="true"></span><span class="nav-shop"><%= @source.shop %></span></span>
      <% end %>
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <% unless on_dashboard %>
        <%= link_to "Open dashboard", dashboard_path(as_of: replay_as_of), class: "btn btn-primary btn-sm nav-cta" %>
      <% end %>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Menu" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="menu-bars" d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="menu-x" d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="site-menu" aria-label="Main" hidden>
    <% links.each do |name, path| %>
      <%= link_to name, path, "aria-current": ("page" if current_page?(path)) %>
    <% end %>
    <% if @replay %><p class="mobile-menu-note">Replay · <%= @as_of.strftime("%b %-d, %Y") %></p><% end %>
    <% unless on_dashboard %>
      <%= link_to "Open dashboard", dashboard_path(as_of: replay_as_of), class: "btn btn-primary" %>
    <% end %>
  </nav>
</header>
