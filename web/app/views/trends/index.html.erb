<%# The dashboard. Styles in app/assets/stylesheets/application.css, behaviour in app/assets/javascripts/app.js. %>
<% content_for :title, "Dashboard · Spike or Stay" %>
<%= render "shared/nav" %>

<main class="wrap app">
  <section class="app-head">
    <div>
      <p class="eyebrow">Dashboard</p>
      <h1>Your products, <em>at a glance</em></h1>
      <p class="lede">Each card shows how much people are reading about a product on Wikipedia, and whether a jump in interest looks short-lived or lasting.</p>
    </div>
    <div class="app-head-actions">
      <% if @replay %>
        <%= link_to "Back to today", dashboard_path, class: "btn btn-outline btn-sm" %>
      <% else %>
        <%= link_to "See a 2017 example", dashboard_path(as_of: "2017-12-31"), class: "btn btn-outline btn-sm" %>
      <% end %>
      <%= link_to "How it works", methodology_path, class: "btn btn-ghost-dark btn-sm" %>
    </div>
  </section>

  <div class="banners">
    <div class="banner info">
      <strong>How to read this:</strong>
      <em>Likely spike</em> means interest jumped but will probably fade, so be careful buying lots of stock.
      <em>Likely sustained</em> means interest looks like it will last. Click a card for the full chart.
    </div>
    <% if @replay %>
      <div class="banner info">
        <strong>Replay as of <%= @as_of.strftime("%B %-d, %Y") %>.</strong>
        Only data from complete weeks up to <%= LiveLabel.last_complete_week_end(@as_of) %> is used.
        <%= link_to "Back to today ›", dashboard_path %>
      </div>
    <% end %>
    <% if notice %><div class="banner success"><%= notice %></div><% end %>
    <% if alert %><div class="banner critical"><%= alert %></div><% end %>
    <% if @as_of_error %><div class="banner warning"><%= @as_of_error %></div><% end %>
    <% if @source&.mode == :demo %>
      <div class="banner info">Demo mode: these are sample products. Add Shopify details to see your own store.</div>
    <% end %>
  </div>

  <%# The cards need Wikipedia data (slow when the cache is cold), so the page renders
      first and app.js fetches them from /dashboard/cards. ?inline=1 renders them in place. %>
  <% if @rows %>
    <%= render "trends/results" %>
  <% else %>
    <%= render "shared/lazy", src: dashboard_cards_path(as_of: (@replay ? params[:as_of] : nil)),
               fallback: dashboard_path(as_of: (@replay ? params[:as_of] : nil), inline: 1),
               what: "products" %>
  <% end %>
</main>

<%= render "shared/footer" %>

<%# Trend panel dialog, filled by app.js when a card is clicked. %>
<dialog class="trend-dialog" aria-label="Product trend">
  <form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="Close">×</button></form>
  <div class="dialog-body" tabindex="-1"></div>
</dialog>
