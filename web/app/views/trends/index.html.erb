<%# The dashboard. Styles in app/assets/stylesheets/application.css, behaviour in app/assets/javascripts/app.js. %>
<% content_for :title, "Dashboard · Spike or Stay" %>
<%= render "shared/nav" %>

<main class="wrap app">
  <section class="app-head">
    <div>
      <p class="eyebrow">Dashboard</p>
      <h1>Your catalog, <em>at a glance</em></h1>
      <p class="lede">Which products are riding a surge in public interest, and whether it's likely to last.</p>
    </div>
    <div class="app-head-actions">
      <% if @replay %>
        <%= link_to "Back to today", dashboard_path, class: "btn btn-outline btn-sm" %>
      <% else %>
        <%= link_to "Try a replay", dashboard_path(as_of: "2017-12-31"), class: "btn btn-outline btn-sm" %>
      <% end %>
      <%= link_to "How it works", methodology_path, class: "btn btn-ghost-dark btn-sm" %>
    </div>
  </section>

  <div class="banners">
    <% if @replay %>
      <div class="banner info">
        <strong>Replay as of <%= @as_of.strftime("%B %-d, %Y") %>.</strong>
        Only data from complete weeks up to <%= LiveLabel.last_complete_week_end(@as_of) %> is used.
        <%= link_to "Back to today ›", dashboard_path %>
      </div>
    <% end %>
    <% if notice %><div class="banner success"><%= notice %></div><% end %>
    <% if alert %><div class="banner critical"><%= alert %></div><% end %>
    <% if @as_of_error %><div class="banner warning"><%= @as_of_error %></div><% end %>
    <% if @fatal_error %><div class="banner critical"><%= @fatal_error %></div><% end %>
    <% if @source&.mode == :demo %>
      <div class="banner info">Demo mode: showing sample products (Shopify credentials not set).</div>
    <% elsif @source&.error %>
      <div class="banner critical">Couldn't load products from <%= @source.shop %>: <%= @source.error %></div>
    <% end %>
  </div>

  <% if @rows.any? %>
    <section class="stats" aria-label="Filter by label">
      <% summary_counts(@rows).each do |key, (name, count)| %>
        <button type="button" class="stat stat-<%= key %>" data-filter="<%= key %>" aria-pressed="false" <%= "disabled" if count.zero? %>>
          <span class="stat-number"><%= count %></span>
          <span class="stat-label"><%= name %></span>
        </button>
      <% end %>
    </section>

    <section>
      <div class="section-head">
        <h2 class="section-title">Products. <span>What public interest says about each one.</span></h2>
        <p class="filter-status" hidden>Showing <strong data-filter-name></strong> · <button type="button" class="link-button" data-filter-clear>Show all</button></p>
      </div>
      <div class="product-grid">
        <% @rows.each do |row| %>
          <% label = row_label(row) %>
          <% chartable = row.article && !row.error && row.recent.present? %>
          <article class="product-card tone-<%= label_tone(label) %><%= ' is-clickable' if chartable %>" data-group="<%= label_group(label) %>">
            <div class="card-top">
              <span class="label tone-<%= label_tone(label) %>"><span class="label-dot"></span><%= label_text(row) %></span>
              <% if row.products.size > 1 %><span class="pill"><%= row.products.size %> products</span><% end %>
            </div>

            <h3 class="product-title"><%= row.products.first[:title] %></h3>
            <% if row.products.size > 1 %>
              <details class="group">
                <summary>+<%= row.products.size - 1 %> more</summary>
                <ul><% row.products.drop(1).each do |product| %><li><%= product[:title] %></li><% end %></ul>
              </details>
            <% end %>

            <% if chartable %><div class="spark-wrap"><%= sparkline(row.recent) %><span class="spark-caption">26 weeks</span></div><% end %>

            <% if row.error %>
              <p class="reason"><%= row.error %></p>
            <% else %>
              <p class="reason"><%= row.result.reason %></p>
              <% if row.result.onset_week %><p class="meta">Surge began week of <%= row.result.onset_week %>.</p><% end %>
            <% end %>
            <% row.notes.to_a.each do |note| %><p class="note"><%= note %></p><% end %>

            <dl class="mapping">
              <div>
                <dt>Term</dt>
                <dd class="terms">
                  <% row.mappings.each do |mapping| %>
                    <span class="term"><%= mapping.term %> <span class="muted">(<%= mapping.source %><%= ", override" if mapping.override_id %>)</span></span>
                  <% end %>
                </dd>
              </div>
              <div>
                <dt>Article</dt>
                <dd class="article"><%= row.article || "—" %></dd>
              </div>
            </dl>

            <div class="card-actions">
              <% if chartable %>
                <%= link_to "View trend ›", trend_path(article: row.article, product: row.products.first[:title], as_of: (@replay ? params[:as_of] : nil)),
                            class: "card-open", data: { trend: true } %>
              <% end %>
              <% row.mappings.each do |mapping| %>
                <%= render "fix_mapping", mapping: mapping, show_term: row.mappings.size > 1 %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
      <p class="filter-empty" hidden>Nothing in this group.</p>
    </section>
  <% end %>
</main>

<%= render "shared/footer" %>

<%# Trend panel dialog, filled by app.js when a card is clicked. %>
<dialog class="trend-dialog" aria-label="Product trend">
  <form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="Close">×</button></form>
  <div class="dialog-body" tabindex="-1"></div>
</dialog>
