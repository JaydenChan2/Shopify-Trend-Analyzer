<%# Sticky top bar shared by the main page and the standalone trend page. %>
<header class="topbar">
  <div class="topbar-inner">
    <%= link_to root_path(as_of: (@replay ? params[:as_of] : nil)), class: "wordmark" do %>
      <span class="wordmark-dot" aria-hidden="true"></span>Spike or Stay
    <% end %>
    <div class="topbar-status">
      <% if @replay %><span class="pill pill-accent">Replay · <%= @as_of.strftime("%b %-d, %Y") %></span><% end %>
      <% if @source&.mode == :demo %>
        <span class="pill">Demo mode</span>
      <% elsif @source&.shop %>
        <span class="pill"><span class="live-dot" aria-hidden="true"></span><%= @source.shop %></span>
      <% end %>
    </div>
  </div>
</header>
